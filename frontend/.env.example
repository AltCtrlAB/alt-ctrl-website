# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL=

# Fortnox integration (Utvecklarportal > the integration > Edit integration)
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
# Space-separated; must match the permissions ticked on the integration
FORTNOX_SCOPES=companyinformation bookkeeping supplierinvoice
# Optional; defaults to https://www.alltunderkontroll.se/api/fortnox/callback
FORTNOX_REDIRECT_URI=
