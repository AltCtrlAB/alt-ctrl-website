# Resend (transactional email)
RESEND_API_KEY=
EMAIL_FROM=
CONTACT_EMAIL=

# Fortnox integration (Utvecklarportal > the integration > Edit integration)
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=
# Space-separated; must match the permissions ticked on the integration
FORTNOX_SCOPES=companyinformation bookkeeping supplierinvoice
# Optional; defaults to https://www.alltunderkontroll.se/api/fortnox/callback
FORTNOX_REDIRECT_URI=

# Spiris integration (credentials from api@spiris.se)
SPIRIS_CLIENT_ID=
SPIRIS_CLIENT_SECRET=
# Public half of the key the customer's refresh token is sealed with, base64 DER on one line.
# Printed by `node scripts/fetch_spiris.ts keygen` in the Ctrl-Z repo; the private half stays there.
SPIRIS_TOKEN_PUBLIC_KEY=
# Optional; defaults to the read-only scopes the production client has been granted
SPIRIS_SCOPES=
# Optional; defaults to https://www.alltunderkontroll.se/api/spiris/callback
SPIRIS_REDIRECT_URI=
